# Controls what goes into the source distribution (sdist).
#
# setuptools only packages the Python files it can infer from `packages` in
# pyproject.toml. Everything the C++ extension needs to compile is invisible to
# it, so without this file the sdist ships pure Python and `pip install` from
# it fails at the CMake configure step.

# Build definition
include CMakeLists.txt
include include/probforge/version.h.in

# Project metadata and docs referenced by [project] in pyproject.toml
include LICENSE
include README.md
include CONTRIBUTING.md
include CHANGELOG.md
include SECURITY.md
include requirements-dev.txt

# C++ / CUDA sources and public headers
graft include
graft src

# C++ unit tests. These are NOT optional: CMakeLists.txt declares the
# probforge_tests executable unconditionally and setup.py builds every target, so
# an sdist missing these files fails to build.
graft tests/cpp

# Python tests, so an install from the sdist can be verified in place.
graft tests/python

# Typing marker
include python/probforge/py.typed
include python/probforge/_probforge.pyi

# Never ship build or editor artifacts
global-exclude *.py[cod]
global-exclude *.so *.pyd *.dll *.dylib
prune **/__pycache__
prune .github
prune .idea
prune examples
